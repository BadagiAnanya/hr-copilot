# Claude is the default provider (ANTHROPIC_API_KEY, or an `ant auth login` profile).
ANTHROPIC_API_KEY=
# Optional alternative provider; used automatically when no Anthropic credential is set.
GROQ_API_KEY=
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour and allows private repos.
GITHUB_TOKEN=

# Groq free tier (8k tokens/minute) needs a small profile:
# ORGKG_CONTEXT_CHARS=6500
# ORGKG_MAX_MODULE_CALLS=0
# ORGKG_MAX_OUTPUT_TOKENS=3200
