# ===== LLM =====
GROQ_API_KEY=your_api_key
GENERATOR_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b

# ===== Slack =====
SLACK_BOT_TOKEN=your_api_key
SLACK_SIGNING_SECRET=your_api_key
SLACK_APP_TOKEN=your_api_key

# ===== Storage =====
POSTGRES_URL=postgresql://hrbot:hrbot@localhost:5432/hrbot
REDIS_URL=redis://localhost:6379/0

# ===== Observability (optional) =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ===== Behavior =====
LOG_LEVEL=INFO
WORKER_CONCURRENCY=4
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.15
SEMANTIC_CACHE_THRESHOLD=0.95

# Local demo: map real Slack member IDs onto seeded employees
# SLACK_USER_ALIASES={"U0123ABCDEF":"U_DEMO_ANANYA"}
